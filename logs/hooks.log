{"ts":"2026-10-05T01:56:15Z","tool":"Bash","command":"python3 - <<'EOF'\np='internal/http/router.go'\ns=open(p).read()\ns=s.replace('''\tmux.Handle(\"/\", interfaz(ui))\n\treturn mux\n}\n''','''\tmux.Handle(\"/\", interfaz(ui))\n\treturn cabecerasSeguridad(mux)\n}\n\n// politicaContenido limita todo al propio origen, que es como se sirve la interfaz compilada:\n// un solo binario, sin CDN, sin fuentes externas y sin scripts ni estilos en linea (Vite\n// emite el script y la hoja de estilos como archivos). data: se permite solo en img-src porque\n// Vite inserta como data URI los recursos pequenos. frame-ancestors reemplaza a X-Frame-Options\n// en los navegadores modernos.\nconst politicaContenido = \"default-src 'self'; script-src 'self'; style-src 'self'; \" +\n\t\"img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; \" +\n\t\"form-action 'self'; frame-ancestors 'none'\"\n\n// cabecerasSeguridad fija las cabeceras de seguridad en todas las respuestas, API e interfaz.\nfunc cabecerasSeguridad(sig http.Handler) http.Handler {\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\th := w.Header()\n\t\th.Set(\"X-Content-Type-Options\", \"nosniff\")\n\t\th.Set(\"X-Frame-Options\", \"DENY\")\n\t\th.Set(\"Referrer-Policy\", \"no-referrer\")\n\t\th.Set(\"Content-Security-Policy\", politicaContenido)\n\t\tsig.ServeHTTP(w, r)\n\t})\n}\n''',1)\nopen(p,'w').write(s)\np='cmd/catalogo/main.go'\ns=open(p).read()\ns=s.replace('''\t\tReadHeaderTimeout: 5 * time.Second,\n\t}''','''\t\t// Los tiempos cubren cada peticion completa. El login es lo mas lento (argon2id con\n\t\t// 64 MiB tarda del orden de 100 ms, y unos segundos si hay varios a la vez), y los\n\t\t// cuerpos admitidos son de hasta 1 MiB, asi que estos margenes sobran.\n\t\tReadHeaderTimeout: 5 * time.Second,  // cabeceras: un cliente legitimo las envia de inmediato\n\t\tReadTimeout:       15 * time.Second, // cabeceras y cuerpo (maximo 1 MiB)\n\t\tWriteTimeout:      30 * time.Second, // incluye el hash de argon2id con carga\n\t\tIdleTimeout:       60 * time.Second, // conexiones keep-alive sin uso\n\t}''',1)\nopen(p,'w').write(s)\nEOF\ncat > internal/db/migraciones/00005_sesion_expira_idx.sql <<'EOF'\n-- +goose Up\nCREATE INDEX sesion_expira_idx ON sesion (expira_en);\n\n-- +goose Down\nDROP INDEX sesion_expira_idx;\nEOF\ngofmt -l cmd internal 2>&1 | head; grep -n \"migraciones\\|00004\" internal/db/*.go | head -5","file":"","decision":"blocked","reason":"ruta absoluta fuera del proyecto: /"}
{"ts":"2026-10-05T02:02:44Z","tool":"Bash","command":"python3 - <<'EOF'\np='web/src/api.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  catalogo: { metodo: 'GET', ruta: '/api/catalogos/{c}' },\n\"\"\",\"\"\"  catalogo: { metodo: 'GET', ruta: '/api/catalogos/{c}' },\n  catalogoCrear: { metodo: 'POST', ruta: '/api/catalogos/{c}' },\n  catalogoActualizar: { metodo: 'PUT', ruta: '/api/catalogos/{c}/{id}' },\n  catalogoDesactivar: { metodo: 'POST', ruta: '/api/catalogos/{c}/{id}/desactivar' },\n  catalogoActivar: { metodo: 'POST', ruta: '/api/catalogos/{c}/{id}/activar' },\n\"\"\")\ns=s.replace(\"\"\"export interface OpcionCatalogo extends Opcion {\n  orden: number\n}\"\"\",\"\"\"export interface OpcionCatalogo extends Opcion {\n  orden: number\n  /** Texto tal como vino del Excel; null en las opciones creadas desde la aplicacion. No se edita. */\n  valor_origen: string | null\n  origen_celda: string | null\n}\n\nexport interface EntradaOpcion {\n  nombre: string\n  orden: number\n}\"\"\")\ns=s.replace(\"\"\"    pedir<{ items: OpcionCatalogo[]; total: number }>(RUTAS.catalogo, { params: { c } }).then((r) => r.items),\n\"\"\",\"\"\"    pedir<{ items: OpcionCatalogo[]; total: number }>(RUTAS.catalogo, { params: { c } }).then((r) => r.items),\n  catalogoCrear: (c: NombreCatalogo, e: EntradaOpcion) =>\n    pedir<OpcionCatalogo>(RUTAS.catalogoCrear, { params: { c }, cuerpo: e }),\n  catalogoActualizar: (c: NombreCatalogo, id: number, e: EntradaOpcion) =>\n    pedir<OpcionCatalogo>(RUTAS.catalogoActualizar, { params: { c, id }, cuerpo: e }),\n  catalogoDesactivar: (c: NombreCatalogo, id: number) =>\n    pedir<OpcionCatalogo>(RUTAS.catalogoDesactivar, { params: { c, id } }),\n  catalogoActivar: (c: NombreCatalogo, id: number) =>\n    pedir<OpcionCatalogo>(RUTAS.catalogoActivar, { params: { c, id } }),\n\"\"\")\nopen(p,'w').write(s)\np='web/src/App.tsx'\ns=open(p).read()\ns=s.replace(\"import Usuarios\",\"import Catalogos from './pantallas/Catalogos'\\nimport Usuarios\")\ns=s.replace(\"\"\"          <NavLink to=\"/usuarios\">\"\"\",\"\"\"          <NavLink to=\"/catalogos\">Catálogos</NavLink>\n          <NavLink to=\"/usuarios\">\"\"\")\ns=s.replace(\"\"\"            <Route path=\"/usuarios\\\"\"\"\",\"\"\"            <Route path=\"/catalogos\" element={<Catalogos />} />\n            <Route path=\"/usuarios\\\"\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > web/src/pantallas/Catalogos.tsx <<'EOF'\nimport { useState, type FormEvent } from 'react'\nimport { api, type NombreCatalogo, type OpcionCatalogo } from '../api'\nimport { useConsulta, Valor } from './comunes'\nimport { CampoForm, ErrorForm, ErrorServidor, SoloAdministrador, useAccion } from './formularios'\n\nconst CATALOGOS: { clave: NombreCatalogo; titulo: string; singular: string }[] = [\n  { clave: 'clases', titulo: 'Clases de servicio', singular: 'clase' },\n  { clave: 'criticidades', titulo: 'Criticidades', singular: 'criticidad' },\n  { clave: 'tipos', titulo: 'Tipos de servicio', singular: 'tipo' },\n]\n\nfunction FormularioOpcion({\n  catalogo,\n  singular,\n  opcion,\n  alTerminar,\n  alCancelar,\n}: {\n  catalogo: NombreCatalogo\n  singular: string\n  opcion: OpcionCatalogo | null\n  alTerminar: () => void\n  alCancelar: () => void\n}) {\n  const [nombre, setNombre] = useState(opcion?.nombre ?? '')\n  const [orden, setOrden] = useState(opcion ? String(opcion.orden) : '')\n  const accion = useAccion()\n\n  async function enviar(e: FormEvent) {\n    e.preventDefault()\n    const entrada = { nombre, orden: Number(orden) }\n    const r = await accion.ejecutar(() =>\n      opcion ? api.catalogoActualizar(catalogo, opcion.id, entrada) : api.catalogoCrear(catalogo, entrada),\n    )\n    if (r) alTerminar()\n  }\n\n  return (\n    <form className=\"panel\" onSubmit={(e) => void enviar(e)}>\n      <h2>{opcion ? `Editar ${singular}: ${opcion.nombre}` : `Nueva ${singular}`}</h2>\n      {opcion && (\n        <p className=\"total\">\n          Valor de origen (no se edita): <code>{opcion.valor_origen ?? 'sin dato'}</code>\n        </p>\n      )}\n      <div className=\"rejilla-form\">\n        <CampoForm etiqueta=\"Nombre\" campo=\"nombre\" error={accion.error}>\n          <input value={nombre} onChange={(e) => setNombre(e.target.value)} />\n        </CampoForm>\n        <CampoForm etiqueta=\"Orden\" campo=\"orden\" error={accion.error}>\n          <input type=\"number\" min={1} value={orden} onChange={(e) => setOrden(e.target.value)} />\n        </CampoForm>\n      </div>\n      <ErrorForm error={accion.error} campos={['nombre', 'orden']} />\n      <div className=\"acciones\">\n        <button type=\"submit\" disabled={accion.ocupado}>{opcion ? 'Guardar cambios' : 'Crear'}</button>\n        <button type=\"button\" className=\"secundario\" onClick={alCancelar}>Cancelar</button>\n      </div>\n    </form>\n  )\n}\n\nfunction Lista({ clave, titulo, singular }: { clave: NombreCatalogo; titulo: string; singular: string }) {\n  const [version, setVersion] = useState(0)\n  const [modo, setModo] = useState<'nuevo' | OpcionCatalogo | null>(null)\n  const [aviso, setAviso] = useState<string | null>(null)\n  const accion = useAccion()\n  const lista = useConsulta(() => api.catalogo(clave), `${clave}|${version}`)\n\n  function terminar(mensaje: string) {\n    setModo(null)\n    setAviso(mensaje)\n    setVersion((v) => v + 1)\n  }\n\n  async function cambiarEstado(o: OpcionCatalogo) {\n    setAviso(null)\n    const r = await accion.ejecutar(() => (o.activo ? api.catalogoDesactivar(clave, o.id) : api.catalogoActivar(clave, o.id)))\n    if (r) setVersion((v) => v + 1)\n  }\n\n  return (\n    <section aria-label={titulo}>\n      <h2>{titulo}</h2>\n      <SoloAdministrador>\n        <p><button type=\"button\" onClick={() => setModo('nuevo')}>Nueva {singular}</button></p>\n      </SoloAdministrador>\n\n      {modo !== null && (\n        <FormularioOpcion\n          key={modo === 'nuevo' ? 'nuevo' : modo.id}\n          catalogo={clave}\n          singular={singular}\n          opcion={modo === 'nuevo' ? null : modo}\n          alCancelar={() => setModo(null)}\n          alTerminar={() => terminar(modo === 'nuevo' ? 'Opción creada.' : 'Cambios guardados.')}\n        />\n      )}\n\n      {aviso && <p className=\"exito\" role=\"status\">{aviso}</p>}\n      {accion.error && <ErrorServidor error={accion.error} />}\n      {lista.error && <p className=\"error\" role=\"alert\">{lista.error}</p>}\n      {lista.cargando && !lista.datos && <p className=\"aviso\" role=\"status\">Cargando…</p>}\n      {lista.datos && (\n        <>\n          <p className=\"total\" role=\"status\">{lista.datos.length} opciones</p>\n          <div className=\"tabla-contenedor\">\n            <table>\n              <thead>\n                <tr>\n                  <th>Orden</th>\n                  <th>Valor de origen</th>\n                  <th>Nombre</th>\n                  <th>Estado</th>\n                  <SoloAdministrador><th>Acciones</th></SoloAdministrador>\n                </tr>\n              </thead>\n              <tbody>\n                {lista.datos.map((o) => (\n                  <tr key={o.id}>\n                    <td>{o.orden}</td>\n                    <td>{o.valor_origen === null ? <Valor v={null} /> : <code>{o.valor_origen}</code>}</td>\n                    <td>{o.nombre}</td>\n                    <td>\n                      <span className={`estado ${o.activo ? 'estado-s' : 'estado-n'}`}>{o.activo ? 'Activo' : 'Inactivo'}</span>\n                    </td>\n                    <SoloAdministrador>\n                      <td className=\"acciones-fila\">\n                        <button type=\"button\" className=\"secundario\" onClick={() => setModo(o)}>Editar</button>\n                        <button type=\"button\" className=\"secundario\" disabled={accion.ocupado} onClick={() => void cambiarEstado(o)}>\n                          {o.activo ? 'Dar de baja' : 'Dar de alta'}\n                        </button>\n                      </td>\n                    </SoloAdministrador>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </>\n      )}\n    </section>\n  )\n}\n\nexport default function Catalogos() {\n  return (\n    <section>\n      <h1>Catálogos</h1>\n      <p className=\"total\">\n        El valor de origen es el texto del Excel y no se edita; el nombre sí. La pareja deja el mapeo verificable.\n      </p>\n      {CATALOGOS.map((c) => (\n        <Lista key={c.clave} {...c} />\n      ))}\n    </section>\n  )\n}\nEOF\ngrep -rn \"ErrorServidor\\|dependencias\" internal/http/catalogo.go | head; grep -n \"DEPENDENCIAS\\|Dependencia\" internal/catalogo/opciones.go | head","file":"","decision":"blocked","reason":"ruta absoluta fuera del proyecto: /api/catalogos/{c}"}
