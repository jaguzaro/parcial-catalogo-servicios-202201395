# Secretos y configuracion local. El enunciado pide no subir archivos de entorno reales
.env
.env.*
!.env.example

# Dependencias instaladas
node_modules/
web/node_modules/
vendor/

# Artefactos de construccion
web/dist/
bin/
*.exe

# Basura del sistema operativo y de los editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Salidas temporales. Los logs de hooks si se versionan, ver logs/README.md
tmp/
*.tmp

# Respaldos locales de configuracion
.claude/*.bak

# Prueba de extremo a extremo
e2e/node_modules/
e2e/test-results/
