# Copie este archivo a .env (o ejecute "make setup") y ajuste los valores.
# Todos los valores de abajo son de EJEMPLO: cambielos fuera de una demostracion local.

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
# Use solo caracteres seguros en una URL (letras, numeros, guion, guion bajo): va dentro de DATABASE_URL.
POSTGRES_PASSWORD=EJEMPLO-cambiar-clave-de-base

# --- Aplicacion ---
# Puerto del anfitrion donde se publica la aplicacion. Cambielo si 8080 esta ocupado.
APP_PORT=8080
# Vida de la sesion (formato de Go: 8h, 30m).
SESSION_TTL=8h
# true cuando se sirve por HTTPS; false para http://localhost.
COOKIE_SECURE=false
# Ruta del Excel DENTRO del contenedor. ./data se monta como solo lectura en /app/data.
EXCEL_PATH=/app/data/CatalogoServicios.xlsx

# Al arrancar, importa el Excel y siembra las cuentas de evaluacion (ambos idempotentes).
# Si falla, se registra en el log y la aplicacion arranca igual. false lo desactiva.
AUTO_INICIO=true

# --- Cuentas de evaluacion (las crea "sembrar-demo") ---
DEMO_ADMIN_USUARIO=admin.ejemplo
DEMO_ADMIN_CONTRASENA=EJEMPLO-admin-cambiar-1
DEMO_CONSULTA_USUARIO=consulta.ejemplo
DEMO_CONSULTA_CONTRASENA=EJEMPLO-consulta-cambiar-1

# --- Solo para las pruebas (proyecto catalogo-test) ---
# Puerto del anfitrion de la aplicacion del proyecto de pruebas.
APP_TEST_PORT=18080
